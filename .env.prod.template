# ── Required: change every value ────────────────────────────
DOMAIN=retromind.example.com
DB_PASSWORD=change_me_db_password_64_chars_minimum
REDIS_PASSWORD=change_me_redis_password_32_chars_minimum
NEO4J_PASSWORD=change_me_neo4j_password_32_chars_minimum
JWT_SECRET=change_me_jwt_secret_64_chars_minimum
ADMIN_API_KEY=change_me_admin_api_key_64_chars_minimum

# ── OCI Object Storage (S3-compatible) ──────────────────────
OCI_REGION=eu-frankfurt-1
OCI_NAMESPACE=your_object_storage_namespace
OCI_ACCESS_KEY=your_s3_compatible_access_key
OCI_SECRET_KEY=your_s3_compatible_secret_key

# ── FreeCAD CAD Export ──────────────────────────────────────
ENABLE_CAD_EXPORT=true
FREECAD_HOST=http://freecad-worker:8100

# ── Optional ────────────────────────────────────────────────
OPENAI_API_KEY=sk-your-key-here
SENTRY_DSN=
WORKSHOP_ID=default
